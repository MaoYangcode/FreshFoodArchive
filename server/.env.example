PORT=3000

# Database fields used by Prisma adapter in src/prisma/prisma.service.ts
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=123456
DATABASE_NAME=fresh_food_archive

# Database URL used by prisma.config.ts (Prisma CLI)
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/fresh_food_archive"

# Optional: future AI integration
DASHSCOPE_API_KEY=
DASHSCOPE_VISION_MODEL=qwen3.6-flash
DASHSCOPE_TEXT_MODEL=qwen2.5-14b-instruct
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
# 1=当外部AI异常时回退本地mock；留空或0=仅真实识别
AI_RECOGNIZE_FALLBACK_TO_MOCK=0
# 1=菜谱生成不足时再补一轮；0=仅首轮返回（更快）
AI_RECIPE_ENABLE_RETRY=0

# Optional Neo4j recipe knowledge graph. Without these values the API automatically uses local JSON hybrid search.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Required for WeChat mini-program login: uni.login(code) -> jscode2session
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# Required for auth token signing. Use a long random string in production.
AUTH_TOKEN_SECRET=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fresh-food-archive.local/schemas/recipe.schema.json",
  "title": "Fresh Food Archive Recipe Knowledge Base",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/recipe" },
  "$defs": {
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "normalizedName", "quantity", "unit", "role", "required", "substitutes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "normalizedName": { "type": "string", "minLength": 1 },
        "quantity": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "rawAmount": { "type": "string", "minLength": 1 },
        "role": { "enum": ["主料", "辅料", "调味料"] },
        "required": { "type": "boolean" },
        "substitutes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "title", "description", "durationMinutes", "heat", "temperatureCelsius", "ingredientsUsed", "cookwareUsed"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 2 },
        "description": { "type": "string", "minLength": 12 },
        "durationMinutes": { "type": "number", "exclusiveMinimum": 0 },
        "heat": { "type": ["string", "null"] },
        "temperatureCelsius": { "type": ["number", "null"], "minimum": 0, "maximum": 300 },
        "ingredientsUsed": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "cookwareUsed": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "nutrition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calories", "protein", "fat", "carbohydrates", "fiber", "sodium", "basis", "estimated"],
      "properties": {
        "calories": { "type": "number", "minimum": 0, "maximum": 2000 },
        "protein": { "type": "number", "minimum": 0, "maximum": 200 },
        "fat": { "type": "number", "minimum": 0, "maximum": 200 },
        "carbohydrates": { "type": "number", "minimum": 0, "maximum": 300 },
        "fiber": { "type": "number", "minimum": 0, "maximum": 80 },
        "sodium": { "type": "number", "minimum": 0, "maximum": 10000 },
        "basis": { "const": "每人份" },
        "estimated": { "const": true }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "score", "version", "curationMethod"],
      "properties": {
        "status": { "enum": ["draft", "source_validated", "machine_validated", "human_verified"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "curationMethod": { "type": "string", "minLength": 1 }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "aliases", "category", "cuisine", "taste", "methods", "difficulty", "durationMinutes", "servings", "ingredients", "cookware", "steps", "tips", "nutritionPerServing", "dietTags", "allergens", "suitableMeals", "embeddingText", "quality"],
      "properties": {
        "id": { "type": "string", "pattern": "^recipe_[0-9]{4}$" },
        "name": { "type": "string", "minLength": 2 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
        "category": { "enum": ["热菜", "汤羹", "主食", "凉菜", "早餐", "轻食", "甜品", "饮品", "调味品", "半成品加工"] },
        "cuisine": { "type": "string", "minLength": 2 },
        "taste": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "methods": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "difficulty": { "enum": ["简单", "中等", "困难"] },
        "durationMinutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 10080 },
        "servings": { "type": "integer", "minimum": 1, "maximum": 12 },
        "ingredients": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/ingredient" } },
        "cookware": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "steps": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/step" } },
        "tips": { "type": "array", "items": { "type": "string", "minLength": 6 }, "uniqueItems": true },
        "nutritionPerServing": { "anyOf": [{ "$ref": "#/$defs/nutrition" }, { "type": "null" }] },
        "dietTags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "allergens": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "suitableMeals": { "type": "array", "minItems": 1, "items": { "enum": ["早餐", "午餐", "晚餐", "加餐"] }, "uniqueItems": true },
        "embeddingText": { "type": "string", "minLength": 30 },
        "quality": { "$ref": "#/$defs/quality" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "sourceRecipeId", "url", "license", "importedAt", "originalCategory", "estimatedFields"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "sourceRecipeId": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" },
            "license": { "type": "string", "minLength": 1 },
            "importedAt": { "type": "string", "format": "date" },
            "originalCategory": { "type": "string", "minLength": 1 },
            "estimatedFields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        }
      }
    }
  }
}
